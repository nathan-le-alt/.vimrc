" Set leader key
let mapleader = " "

""" ===== General settings =====
syntax on            " enable syntax highlighting
set number           " show line numbers
" set relativenumber   " show relative line numbers (great for jumping)
set mouse=a          " enable mouse support
set cursorline        " highlight the current line
set showcmd           " show partial command in the last line
set ruler             " show cursor position
" set spell spelllang=en_us
set encoding=UTF-8
set nocp              " disable vi compatibility mode
set termguicolors     " enable true color support


" set fileformat
if has('win32') || has('win64')
  set fileformat=dos       " Default format for brand new files on Windows
else
  set fileformat=unix      " Default format for brand new files on Unix/macOS
endif

" --- Indentation ---
set tabstop=2        " number of visual spaces per tab
set softtabstop=2    " number of spaces in tab when editing
set shiftwidth=2     " number of spaces to use for autoindent
" set noexpandtab      " use tabs
set expandtab         " convert tabs to spaces
filetype plugin indent on
autocmd FileType python setlocal tabstop=4 softtabstop=4 shiftwidth=4
set breakindent
set linebreak
" set showbreak=>\

" --- Search and navigation ---
set hlsearch         " highlight search results
set incsearch        " search as you type
set ignorecase       " case insensitive search...
set smartcase        " ...unless you use a capital letter
set scrolloff=8       " keep 8 lines visible above and below cursor

" --- Performance and behavior ---
set hidden           " allow background buffers
set nobackup         " don't create backup files
set noswapfile       " don't create swap files
"set clipboard=unnamedplus    " use the system clipboard
if has('unnamedplus')
  set clipboard=unnamedplus
else
  set clipboard=unnamed
endif

" --- Splitting ---
set splitbelow          " split below when splitting horizontal
set splitright          " split to the right when splitting vertical

